# === Hermes Claude Proxy v5 (hardened fork) ===

# Server port
PORT=3456

# Bind address. Loopback by default — do NOT expose this port to the network.
HOST=127.0.0.1

# REQUIRED. The server refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=

# Tools the agent may use. Read-only by default.
# Adding Bash(*)/Write/Edit gives anything that can reach this port
# shell and filesystem access as your user. Only do it deliberately.
ALLOWED_TOOLS=WebSearch,WebFetch,Read,Grep,Glob

# 1 = stateless (no cross-request state). Recommended.
STATELESS_MODE=1

# Max concurrent requests (recommended: 2 for Claude Max subscription)
MAX_CONCURRENT=2

# Request timeout in milliseconds (5 minutes)
REQUEST_TIMEOUT=300000

# Auto-retry failed requests (0 = no retry)
MAX_RETRIES=1

# Plugin directory (drop .js files here for pre/post processing)
PLUGINS_DIR=./plugins

# --- Client-side tool calling -------------------------------------------------
# Requests containing an OpenAI `tools` array are routed through tool-bridge.js,
# which uses the SDK's query() API (unstable_v2_* cannot register MCP servers).
# One tool call is returned per round-trip; the client executes it and sends the
# result back as a role:"tool" message. No extra configuration needed.
